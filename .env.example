APOLLO_API_KEY=replace_with_your_local_apollo_api_key
APOLLO_BASE_URL=https://api.apollo.io/api/v1

# Optional AI providers. Each user keeps their own credentials locally.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=

# Local web CRM. Render supplies PORT automatically.
OFFSETX_WEB_HOST=127.0.0.1
OFFSETX_WEB_PORT=8766
OFFSETX_LOCAL_API_TOKEN=
# Optional single-user demo login. Set all three together; never commit real values.
OFFSETX_DEMO_USERNAME=
OFFSETX_DEMO_PASSWORD=
OFFSETX_SESSION_SECRET=
OFFSETX_SESSION_HOURS=8
OFFSETX_OUTREACH_DB=local_data/offsetx_outreach.db
OFFSETX_GMAIL_CLIENT_SECRETS=
OFFSETX_GMAIL_TOKEN=local_data/gmail_token.json
OFFSETX_OWN_EMAIL=
