APOLLO_API_KEY=replace_with_your_local_apollo_api_key
APOLLO_BASE_URL=https://api.apollo.io/api/v1

# Optional AI providers. Each user keeps their own credentials locally.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=

# Sender identity. Keep personal contact details in local/hosted secrets, not Git.
OFFSETX_SENDER_NAME=
OFFSETX_SENDER_ROLE=Building OffsetX - carbon-market infrastructure
OFFSETX_SENDER_EMAIL=
OFFSETX_SENDER_LINKEDIN=

# OFF_CRM runtime. Render supplies PORT automatically.
OFF_CRM_WEB_HOST=127.0.0.1
OFF_CRM_WEB_PORT=8766
OFF_CRM_LOCAL_API_TOKEN=
OFF_CRM_DATA_DIR=local_data
OFF_CRM_DB=local_data/off_crm.db
OFF_CRM_MAX_UPLOAD_BYTES=10485760

# Optional single-user demo login. Set all three together; never commit real values.
OFF_CRM_DEMO_USERNAME=
OFF_CRM_DEMO_PASSWORD=
OFF_CRM_SESSION_SECRET=
OFF_CRM_SESSION_HOURS=8

# Gmail is a separate connector. Its token is held by the mail module only.
OFF_CRM_GMAIL_CLIENT_SECRETS=
OFF_CRM_GMAIL_TOKEN=local_data/gmail_token.json
OFF_CRM_OWN_EMAIL=

# The only sender-side text allowed in an AI outreach packet.
OFF_CRM_PUBLIC_POSITIONING=Building OffsetX - carbon-market infrastructure
OFF_CRM_OWNER_DOMAINS=

# OFFSETX_* runtime aliases from releases <=0.11 remain accepted for migration.
