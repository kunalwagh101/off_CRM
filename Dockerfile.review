# Review-only build harness. It is not used by off_CRM's production Dockerfile.
# Source: develop. A failed gate fails the image build and is visible in Render build logs.
FROM node:24-alpine AS frontend-checks
WORKDIR /review/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
COPY tests/fixtures/ /review/tests/fixtures/
RUN npm test
RUN npm run build
RUN npm audit --omit=dev --audit-level=low
RUN npm audit --audit-level=high

FROM python:3.12-slim AS backend-checks
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /review
COPY . .
# Review tests use Git CLI to create actual temporary shallow/full clones.
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.8.17 /uv /usr/local/bin/uv
COPY --from=frontend-checks /review/frontend/dist /review/frontend/dist
RUN uv sync --locked --extra dev --extra email --extra postgres
ENV PATH="/review/.venv/bin:$PATH"
RUN uv run ruff check --select E9,F63,F7,F82 .
# Story-specific QA acceptance: persisted >500 contacts and every spreadsheet tab.
RUN uv run pytest -v --tb=short tests/test_contacts_filters_export.py tests/test_spreadsheet_exports.py tests/test_existing_poi_enrichment.py tests/test_apollo_rejection_ledger.py

# WP1 security review: run the lost-context regression before other suites.
RUN uv run pytest -q tests/test_workspace_isolation.py::test_lost_request_context_cannot_read_other_workspaces_product tests/test_workspace_isolation.py::test_only_explicit_timer_scope_can_read_linked_product_without_a_request tests/test_gtm_product_wiring.py::test_the_engine_reads_the_product_linked_from_another_workspace
# Verify CI contracts and shallow/full clone behaviour with real git first.
RUN uv run pytest -q tests/test_ci_verifier_environment.py tests/test_verify_board.py
# Run every installed Python test, not only a curated selection of review items.
RUN uv run pytest -q
# Review-only PostgreSQL: all state is disposable inside this Docker build.
# Both runs use a real PostgreSQL server and never touch Render QA/customer DB.
FROM backend-checks AS postgres-checks
RUN apt-get update && apt-get install -y --no-install-recommends postgresql && rm -rf /var/lib/apt/lists/*
RUN set -eu; \
    PGVER="$(pg_lsclusters --no-header | awk 'NR==1 {print $1}')"; \
    pg_ctlcluster --skip-systemctl-redirect "$PGVER" main start; \
    su postgres -c "psql -v ON_ERROR_STOP=1 -c \"CREATE ROLE offcrmqa LOGIN PASSWORD 'qa-only-local' CREATEDB\""; \
    su postgres -c "createdb -O offcrmqa offcrmqa"; \
    export OFF_CRM_TEST_POSTGRES_URL="postgresql://offcrmqa:qa-only-local@127.0.0.1:5432/offcrmqa"; \
    uv run pytest -q tests/test_hosted_storage.py::test_postgres_logout_revocation_reaches_another_live_app_and_survives_restart; \
    uv run pytest -q tests/test_crm_hosted.py tests/test_hosted_storage.py tests/test_db_backend.py tests/test_storage_inventory.py tests/test_video_postgres.py tests/test_crm_harness.py; \
    OFF_CRM_TEST_CRM_ON_POSTGRES=1 uv run pytest -q

# Require both audited frontend and fully tested SQLite/PostgreSQL backend before publishing the QA marker.
FROM frontend-checks AS verified-review
COPY --from=postgres-checks /review/frontend/dist /tmp/python-and-postgres-gates-passed
EXPOSE 10000
CMD ["node", "-e", "require('http').createServer((_,res)=>{res.writeHead(200);res.end('QA checks passed')}).listen(10000,'0.0.0.0')"]
