# Review-only build harness. It is not used by off_CRM's production Dockerfile.
# Source: develop. A failed gate fails the image build and is visible in Render build logs.
FROM node:24-alpine AS frontend-checks
WORKDIR /review/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
COPY tests/fixtures/ /review/tests/fixtures/
RUN npm test
RUN npm run build
RUN npm audit --omit=dev --audit-level=low

FROM python:3.12-slim AS backend-checks
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /review
COPY . .
COPY --from=ghcr.io/astral-sh/uv:0.8.17 /uv /usr/local/bin/uv
COPY --from=frontend-checks /review/frontend/dist /review/frontend/dist
RUN uv sync --locked --extra dev --extra email --extra postgres
ENV PATH="/review/.venv/bin:$PATH"
RUN uv run ruff check --select E9,F63,F7,F82 .
# Review wave 2: security, browser containment, GTM and recovery regressions.
# -v preserves every result; any failure stops this QA image.
RUN uv run pytest -v --tb=short \
    tests/test_workspace_isolation.py \
    tests/test_workspace_lock.py \
    tests/test_cli_workspace_lease.py \
    tests/test_browser_agent.py \
    tests/test_browser_box.py \
    tests/test_browser_vault.py \
    tests/test_browser_vault_wiring.py \
    tests/test_browser_revoke.py \
    tests/test_browser_countdown.py \
    tests/test_browser_platform_registry.py \
    tests/test_ai_egress_wall.py \
    tests/test_privacy.py \
    tests/test_gtm_product_wiring.py \
    tests/test_hosted_storage.py \
    tests/test_db_backend.py \
    tests/test_frontend_accessibility_contract.py
# All Python gates must run even when a development-only npm advisory fails.
FROM frontend-checks AS final-audit
COPY --from=backend-checks /review/frontend/dist /tmp/python-gates-passed
RUN npm audit --audit-level=high
EXPOSE 10000
CMD ["node", "-e", "require('http').createServer((_,res)=>{res.writeHead(200);res.end('QA checks passed')}).listen(10000,'0.0.0.0')"]
