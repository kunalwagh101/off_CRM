# Review-only build harness. It is not used by off_CRM's production Dockerfile.
# Source: develop. A failed gate fails the image build and is visible in Render build logs.
FROM node:24-alpine AS frontend-checks
WORKDIR /review/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
COPY tests/fixtures/ /review/tests/fixtures/
RUN npm test
RUN npm run build
RUN npm audit --omit=dev --audit-level=low
RUN npm audit --audit-level=high

FROM python:3.12-slim AS backend-checks
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /review
COPY . .
# Review tests use Git CLI to create actual temporary shallow/full clones.
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.8.17 /uv /usr/local/bin/uv
COPY --from=frontend-checks /review/frontend/dist /review/frontend/dist
RUN uv sync --locked --extra dev --extra email --extra postgres
ENV PATH="/review/.venv/bin:$PATH"
RUN uv run pytest -q tests/test_imagery.py -k A21
# A21 must not break the video editor's lightweight media-header probe.
RUN uv run pytest -q tests/test_imagery.py tests/test_video_gates.py tests/test_video_captions.py
RUN uv run pytest -q -s tests/test_crm_duplicate_review.py
# S-06.02.55 / A18: numeric evidence must fail fast before the full expensive QA suite.
RUN uv run pytest -q tests/test_agent_claim_verification.py -k A18
RUN uv run ruff check --select E9,F63,F7,F82 .
RUN uv run pytest -q tests/test_public_demo.py tests/test_public_demo_ai.py tests/test_public_demo_entrypoint.py tests/test_api_auth.py
# S-06.03.06: hosted automation settings, test-first gate before broad suites.
RUN uv run pytest -q tests/test_timer_migration.py
RUN uv run pytest -q tests/test_hosted_timer_settings.py
# S-06.03.06: AI context durability RED/GREEN gate before wide regressions.
RUN uv run pytest -q tests/test_context_import.py
RUN uv run pytest -q tests/test_hosted_ai_context.py
# Hosted SQLite readiness must use the actual context database, not the old file.
RUN uv run pytest -q tests/test_crm_hosted.py::test_a_campaign_made_in_the_app_outlives_the_disk tests/test_crm_hosted.py::test_a_local_crm_holding_only_what_every_start_writes_does_not_stop_the_start tests/test_hosted_storage.py::test_readiness_checks_the_hosted_database
# F-06.03 storage readiness TDD: fail fast before the long regression stages.
RUN uv run pytest -q tests/test_hosted_storage_readiness.py
# F-06.01.02: targeted permission and browser action-gate tests run first.
RUN uv run pytest -q tests/test_agent_permissions.py tests/test_agent_run.py
# A new app-state service must be in the storage inventory and close on restore.
RUN uv run pytest -q tests/test_storage_inventory.py::test_every_service_the_app_opens_is_classified tests/test_audit_wp1.py::test_every_open_service_is_closed_for_a_restore
# Enforce the existing typed-body API contract before the long regressions.
RUN uv run pytest -q tests/test_api_auth.py::test_no_api_route_accepts_an_untyped_raw_dict_body
# F-06.02 operator scheduler health; targeted API/security gate first.
RUN uv run pytest -q tests/test_operational_health.py

# Story-specific QA acceptance: persisted >500 contacts and every spreadsheet tab.
RUN uv run pytest -v --tb=short tests/test_contacts_filters_export.py tests/test_spreadsheet_exports.py tests/test_existing_poi_enrichment.py tests/test_apollo_rejection_ledger.py

# WP1 security review: run the lost-context regression before other suites.
RUN uv run pytest -q tests/test_workspace_isolation.py::test_lost_request_context_cannot_read_other_workspaces_product tests/test_workspace_isolation.py::test_only_explicit_timer_scope_can_read_linked_product_without_a_request tests/test_gtm_product_wiring.py::test_the_engine_reads_the_product_linked_from_another_workspace
# Deterministic D-314 cursor-fetch lock ownership proof before stress and broad tests.
RUN uv run pytest -q tests/test_crm_read_lock.py
# Diagnose intermittent WP1 concurrent campaign create. Every iteration is a real
# independent SQLite app/restart run; do not silence any failed 201 response.
RUN for attempt in $(seq 1 12); do \
      echo "WP1 concurrency repetition ${attempt}/12"; \
      uv run pytest -q tests/test_wp1_recovery_edges.py::test_concurrent_api_writes_are_all_durable_after_restart || exit 1; \
    done
# Verify CI contracts and shallow/full clone behaviour with real git first.
RUN uv run pytest -q tests/test_ci_verifier_environment.py tests/test_verify_board.py
# Structural board check (Git ancestry not available in the Docker context).
RUN uv run python scripts/verify_board.py --skip-tests
# Run every installed Python test, not only a curated selection of review items.
RUN uv run pytest -q
# Chromium acceptance is isolated to the review image, never production.
# The script starts a disposable local FastAPI server and imports synthetic CSV.
FROM backend-checks AS chromium-checks
RUN apt-get update && apt-get install -y --no-install-recommends chromium && rm -rf /var/lib/apt/lists/*
RUN uv pip install --python /review/.venv/bin/python playwright==1.56.0
# A18: real Chrome page capture + model-supplied incorrect signed/decimal result.
RUN uv run pytest -q tests/test_agent_claim_verification.py -k A18_real_chromium
RUN uv run --no-sync python scripts/live/review_contacts_browser.py
RUN uv run --no-sync python scripts/live/review_public_demo_browser.py

# Review-only PostgreSQL: all state is disposable inside this Docker build.
# Both runs use a real PostgreSQL server and never touch Render QA/customer DB.
FROM backend-checks AS postgres-checks
RUN apt-get update && apt-get install -y --no-install-recommends postgresql && rm -rf /var/lib/apt/lists/*
RUN set -eu; \
    PGVER="$(pg_lsclusters --no-header | awk 'NR==1 {print $1}')"; \
    pg_ctlcluster --skip-systemctl-redirect "$PGVER" main start; \
    su postgres -c "psql -v ON_ERROR_STOP=1 -c \"CREATE ROLE offcrmqa LOGIN PASSWORD 'qa-only-local' CREATEDB\""; \
    su postgres -c "createdb -O offcrmqa offcrmqa"; \
    export OFF_CRM_TEST_POSTGRES_URL="postgresql://offcrmqa:qa-only-local@127.0.0.1:5432/offcrmqa"; \
    uv run pytest -q tests/test_context_import.py::test_postgresql_context_import_survives_reconnect; \
    uv run pytest -q tests/test_hosted_ai_context.py::test_hosted_context_on_disposable_postgres_after_reconnect; \
    uv run pytest -q tests/test_hosted_storage.py::test_postgres_logout_revocation_reaches_another_live_app_and_survives_restart; \
    uv run pytest -q tests/test_crm_hosted.py tests/test_hosted_storage.py tests/test_db_backend.py tests/test_storage_inventory.py tests/test_video_postgres.py tests/test_crm_harness.py; \
    OFF_CRM_TEST_CRM_ON_POSTGRES=1 uv run pytest -q

# Require both audited frontend and fully tested SQLite/PostgreSQL backend before publishing the QA marker.
FROM frontend-checks AS verified-review
COPY --from=postgres-checks /review/frontend/dist /tmp/python-and-postgres-gates-passed
COPY --from=chromium-checks /review/frontend/dist /tmp/chromium-contacts-accepted
EXPOSE 10000
CMD ["node", "-e", "require('http').createServer((_,res)=>{res.writeHead(200);res.end('QA checks passed')}).listen(10000,'0.0.0.0')"]
