# Review-only build harness. It is not used by off_CRM's production Dockerfile.
# Source: develop. A failed gate fails the image build and is visible in Render build logs.
FROM node:24-alpine AS frontend-checks
WORKDIR /review/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
COPY tests/fixtures/ /review/tests/fixtures/
RUN npm test
RUN npm run build
RUN npm audit --omit=dev --audit-level=low

# Temporary lockfile remediation probe, executed only by this isolated QA build.
FROM node:24-alpine AS lock-patch
WORKDIR /review/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN cp package-lock.json /tmp/original-lock.json
RUN npm install vitest@4.1.11 --save-dev --save-exact --package-lock-only --ignore-scripts --no-fund --no-audit
RUN npm audit fix --package-lock-only --ignore-scripts --no-fund
RUN node -e 'const fs=require("fs");const a=JSON.parse(fs.readFileSync("/tmp/original-lock.json"));const b=JSON.parse(fs.readFileSync("package-lock.json"));for(const k of Object.keys(b.packages)){if(JSON.stringify(a.packages[k])!==JSON.stringify(b.packages[k])){console.log("LOCK_PATCH "+k+" "+JSON.stringify(b.packages[k]))}}for(const k of Object.keys(a.packages)){if(!b.packages[k])console.log("LOCK_REMOVE "+k)}console.log("LOCK_MANIFEST "+fs.readFileSync("package.json","utf8").replace(/\\s*\\n\\s*/g,""))'
RUN npm audit --audit-level=high

FROM python:3.12-slim AS backend-checks
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /review
COPY . .
COPY --from=ghcr.io/astral-sh/uv:0.8.17 /uv /usr/local/bin/uv
COPY --from=frontend-checks /review/frontend/dist /review/frontend/dist
RUN uv sync --locked --extra dev --extra email --extra postgres
ENV PATH="/review/.venv/bin:$PATH"
RUN uv run ruff check --select E9,F63,F7,F82 .
# Review wave 4: resolve the remaining un-mapped IN_REVIEW stories.
RUN uv run pytest -v --tb=short \
    tests/test_crawler_frontier.py \
    tests/test_extraction_packs.py \
    tests/test_competitor_teardown.py \
    tests/test_discovery.py \
    tests/test_exclusion_discovery.py \
    tests/test_parallel_discovery_and_notion.py \
    tests/test_meeting_transcription.py \
    tests/test_provider_usage_report.py \
    tests/test_traceable_errors.py \
    tests/test_trace_ids.py \
    tests/test_outreach_email_expert.py \
    tests/test_frontend_accessibility_contract.py \
    tests/test_gtm_strategy.py
# All Python gates must run even when a development-only npm advisory fails.
FROM frontend-checks AS final-audit
COPY --from=lock-patch /review/frontend/package-lock.json /tmp/lock-remediation-probe.json
COPY --from=backend-checks /review/frontend/dist /tmp/python-gates-passed
RUN npm audit --audit-level=high
EXPOSE 10000
CMD ["node", "-e", "require('http').createServer((_,res)=>{res.writeHead(200);res.end('QA checks passed')}).listen(10000,'0.0.0.0')"]
