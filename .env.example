APOLLO_API_KEY=replace_with_your_local_apollo_api_key
APOLLO_BASE_URL=https://api.apollo.io/api/v1

# AI provider keys are typed in the app, under Connectors, never set here: a
# key in the server's environment would serve every login (DD-64, D-151).

# Sender identity. Keep personal contact details in local/hosted secrets, not Git.
OFFSETX_SENDER_NAME=
OFFSETX_SENDER_ROLE=Building OffsetX - carbon-market infrastructure
OFFSETX_SENDER_EMAIL=
OFFSETX_SENDER_LINKEDIN=

# Local web CRM. Render supplies PORT automatically.
OFFSETX_WEB_HOST=127.0.0.1
OFFSETX_WEB_PORT=8766
OFFSETX_LOCAL_API_TOKEN=
# Optional single-user demo login. Set all three together; never commit real values.
OFFSETX_DEMO_USERNAME=
OFFSETX_DEMO_PASSWORD=
OFFSETX_SESSION_SECRET=
OFFSETX_SESSION_HOURS=8
# Everything durable lives in one folder, and a backup covers that folder. The
# CRM database and the Gmail token default to files inside it. Leave their
# lines commented out: a path set here does not move when the folder does.
# OFFSETX_DATA_DIR=local_data
# OFFSETX_OUTREACH_DB=local_data/offsetx_outreach.db
# OFFSETX_GMAIL_TOKEN=local_data/gmail_token.json

# Keep provider keys, AI settings, usage counters and logins in a hosted
# PostgreSQL instead of the data folder — any PostgreSQL 13 or newer: Neon or
# Render now, AWS or Azure later. Set both or neither. Make the key with
# `offsetx-db new-secrets-key` and keep a copy: without it nobody can read the
# stored provider keys. docs/architecture/HOSTED_STORAGE.md
# OFFSETX_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# OFFSETX_SECRETS_KEY=
OFFSETX_GMAIL_CLIENT_SECRETS=
OFFSETX_OWN_EMAIL=

# Required for live permission marketing or SES bulk outreach. Use a public HTTPS origin and a
# random secret of at least 32 bytes. AWS credentials stay in the standard AWS
# environment/role chain and are never stored by off_CRM.
OFFSETX_PUBLIC_BASE_URL=
OFFSETX_UNSUBSCRIBE_SECRET=
